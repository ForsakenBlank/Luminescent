   "greeting_script": "# Written by Luminescent for the theme's start-up text (theme settings > Terminal). It takes the place\n# of your own fish_greeting while it is here; delete this file, or untick the start-up text in the\n# theme, to get yours back.\nfunction fish_greeting\n    set -l w $COLUMNS\n    if test $w -ge 13\n        printf '\\e[35m'\n        printf '%s\\n' 'Welcome back' 'it\\'s \\'Monday\\''\n        set_color normal\n    end\n    command -q fastfetch; or return\n    if test $w -lt 20\n        return\n    else\n        fastfetch -c '<HOME>/.config/fastfetch/luminescent.jsonc' --pipe false\n    end\nend\n",
   "kitty_theme_conf": "# Luminescent theme colours, rewritten whenever the theme changes. Do not edit.\nbackground #282828\nforeground #EBDBB2\ncursor #FE8019\nselection_background #4B2C13\nselection_foreground #EBDBB2\nactive_border_color #FE8019\ninactive_border_color #504945\nurl_color #FEAC6A\ncolor0 #3C3836\ncolor1 #FB4934\ncolor2 #B1D791\ncolor3 #FAD69D\ncolor4 #97AEDF\ncolor5 #FE8019\ncolor6 #A1D6BE\ncolor7 #BDAE93\ncolor8 #817868\ncolor9 #F38B90\ncolor10 #B6E8B2\ncolor11 #FAE7BD\ncolor12 #9EC2FB\ncolor13 #D4B6F8\ncolor14 #A7E7DD\ncolor15 #EBDBB2\ndynamic_background_opacity yes\nbackground_opacity 1.00\n",
   "fastfetch_config": "// Written by Luminescent from the theme's Terminal page (the info box). It is rewritten when the theme changes;\n// your own config.jsonc is not used for it.\n{\n    \"$schema\": \"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json\",\n    \"display\": {\n        \"separator\": \"  \"\n    },\n    \"modules\": [\n        \"break\",\n        {\n            \"type\": \"custom\",\n            \"key\": \"╭────────────────────────────────────\",\n            \"keyColor\": \"35\",\n            \"format\": \"\"\n        },\n        {\n            \"type\": \"os\",\n            \"key\": \"│ distro\",\n            \"keyColor\": \"94\"\n        },\n        {\n            \"type\": \"memory\",\n            \"key\": \"│ ram   \",\n            \"keyColor\": \"38;5;16\"\n        },\n        {\n            \"type\": \"colors\",\n            \"key\": \"│       \",\n            \"symbol\": \"circle\"\n        },\n        {\n            \"type\": \"custom\",\n            \"key\": \"╰────────────────────────────────────\",\n            \"keyColor\": \"35\",\n            \"format\": \"\"\n        },\n        \"break\"\n    ],\n    \"logo\": {\n        \"type\": \"auto\",\n        \"source\": \"<HOME>/Pictures/logo.png\",\n        \"width\": 200,\n        \"padding\": {\n            \"top\": 0,\n            \"left\": 2,\n            \"right\": 2\n        },\n        \"position\": \"top\"\n    }\n}\n"
